<?xml version="1.0"?>
<package format="2">
  <name>referee_radar_slam</name>
  <version>2.0.0</version>
  <description>ReFeree radar SLAM on ROS 1: radar odometry + ReFeree loop closing + iSAM2, the same estimation as
    the ROS 2 packages (applications/slam/common).</description>
  <maintainer email="hg.kim@inha.edu">Hogyun Kim</maintainer>
  <maintainer email="bhbhchoi@inha.edu">Byunghee Choi</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>
</package>
